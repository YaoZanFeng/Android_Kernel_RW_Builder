# Android Common Kernel official Git repository.
# Source discovery/download uses Git refs, not Gitiles +archive pages.
KERNEL_REMOTE=${KERNEL_REMOTE:-https://android.googlesource.com/kernel/common}

# Generic fallback mirror for environments where android.googlesource.com Git is unreachable.
# Override either URL at runtime when needed.
KERNEL_REMOTE_FALLBACK=${KERNEL_REMOTE_FALLBACK:-https://mirrors.tuna.tsinghua.edu.cn/git/AOSP/kernel/common}

KERNEL_ARCH=arm64
CI_TARGET=kernel_aarch64

JOBS=
LLVM=1
LLVM_IAS=1
